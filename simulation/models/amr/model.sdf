<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="amr">
    <static>false</static>

    <!-- Robot body -->
    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>

      <!-- Inertial -->
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.15</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Visual — robot body (rectangular base) -->
      <visual name="body_visual">
        <geometry>
          <box><size>0.5 0.4 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.6 0.8 1</ambient>
          <diffuse>0.2 0.6 0.8 1</diffuse>
        </material>
      </visual>

      <!-- Collision -->
      <collision name="body_collision">
        <geometry>
          <box><size>0.5 0.4 0.15</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Left wheel -->
    <link name="left_wheel">
      <pose>0 0.22 -0.05 0 1.5708 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_visual">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="wheel_collision">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.03</length></cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Right wheel -->
    <link name="right_wheel">
      <pose>0 -0.22 -0.05 0 1.5708 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_visual">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="wheel_collision">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.03</length></cylinder>
        </geometry>
      </collision>
    </link>

    <!-- LiDAR sensor (top of robot) -->
    <link name="lidar_link">
      <pose>0 0 0.1 0 0 0</pose>
      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.04</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Joints -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <pose>0 0.22 -0.10 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <pose>0 -0.22 -0.10 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- Differential drive plugin -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_frame_id>odom</odom_frame_id>
      <tf_frame_id>base_footprint</tf_frame_id>
      <odom_topic>odom</odom_topic>
      <cmd_vel_topic>cmd_vel</cmd_vel_topic>
    </plugin>

    <!-- LiDAR sensor plugin -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Bumper (contact detection) -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
      <contact_sensor_name>contact_sensor</contact_sensor_name>
    </plugin>

  </model>
</sdf>
